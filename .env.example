# ==============================================================================
# MoieRec Root Environment Variables Template
# ==============================================================================
# Note: Do not store actual production secrets or keys in this file.
# Copy this file to .env (or backend/.env and frontend/.env) for local dev.

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECRET_KEY=moierec-development-secret-key-change-in-production

# Future Integrations (Phase 2+)
MONGODB_URI=mongodb://localhost:27017/moierec
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
